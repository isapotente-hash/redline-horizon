{
  "name": "redline-horizon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --import tsx --test scripts/*.test.ts",
    "assets": "node --import tsx scripts/export-assets.ts && blender --background --python scripts/blender-assets.py -- --project .",
    "build:offline": "tsc --noEmit && vite build --mode offline && node scripts/offline.mjs"
  },
  "dependencies": {
    "three": "0.180.0",
    "@dimforge/rapier3d-compat": "0.19.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "tsx": "4.20.5"
  }
}
